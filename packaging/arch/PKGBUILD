# Repacks the Tauri .deb into a pacman package.
#
# scripts/install-local.sh ends in `sudo dpkg -i`, which cannot work on Arch.
# This existed only as ad-hoc shell history until now, so every reinstall had
# to rediscover it. Deps mirror the .deb's Depends line.
#
# Normally you want the whole thing, which drives this file:
#
#   bash scripts/install-local-arch.sh        # or: pnpm install:local:arch
#
# By hand, if you already have a .deb (note the ABSOLUTE path — pkexec resets
# the working directory and cannot see a relative one):
#
#   cd packaging/arch && makepkg -f
#   pkexec pacman -U --noconfirm "$PWD"/agent-office-*.pkg.tar.zst
#
# `pacman -U` refuses an identical pkgver-pkgrel, which is what a second build
# of one version produces — hence AO_PKGREL, which the script sets to a
# timestamp. pkgver stays literal: set-version.mjs writes it and
# check-version-sync.mjs asserts it matches apps/web/package.json.

pkgname=agent-office
pkgver=0.2.0
pkgrel=${AO_PKGREL:-1}
pkgdesc="Agent Office - a desktop cockpit for Claude Code agents"
arch=('x86_64')
url="https://github.com/nakotomagami-a11y/agent-office"
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg' 'openssl')
options=('!strip' '!debug')

_debdir="$startdir/../../apps/web/src-tauri/target/release/bundle/deb"

package() {
  local deb
  deb="$(find "$_debdir" -maxdepth 1 -name '*.deb' -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)"
  if [[ -z "$deb" ]]; then
    echo "no .deb found in $_debdir — run 'pnpm tauri build --bundles deb' first" >&2
    return 1
  fi
  echo "repacking: $deb"
  bsdtar -xOf "$deb" data.tar.gz | bsdtar -xzf - -C "$pkgdir"
}
