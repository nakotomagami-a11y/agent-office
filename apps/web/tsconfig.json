{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@agent-office/domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@agent-office/domain/*": [
        "../../packages/domain/src/*"
      ],
      "@agent-office/api-contract": [
        "../../packages/api-contract/src/index.ts"
      ],
      "@agent-office/server": [
        "../server/src/index.ts"
      ],
      "@agent-office/server/boot": [
        "../server/src/boot.ts"
      ],
      "@agent-office/server/guard": [
        "../server/src/guard.ts"
      ],
      "@agent-office/server/render": [
        "../server/src/render.ts"
      ]
    }
  },
  "include": [
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*",
    "./.next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
