{
  "name": "@agent-office/domain",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./config/routes": "./src/config/routes.ts",
    "./config/agent-opts": "./src/config/agent-opts.ts",
    "./config/run-errors": "./src/config/run-errors.ts",
    "./config/integrations": "./src/config/integrations.ts",
    "./config/office": "./src/config/office.ts",
    "./config/project-templates": "./src/config/project-templates.ts",
    "./config/*": "./src/config/*.ts",
    "./hooks/query-keys": "./src/hooks/query-keys.ts",
    "./hooks/api": "./src/hooks/api.ts",
    "./services": "./src/services/index.ts",
    "./services/db": "./src/services/db/index.ts",
    "./services/*": "./src/services/*.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test $(find src -name \"*.test.ts\" ! -name \"*e2e*\")",
    "test:e2e": "tsx --test $(find src -name \"*e2e*.test.ts\")"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.9.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.15.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cross-spawn": "^7.0.6"
  }
}
